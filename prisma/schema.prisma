// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  INTERN
  MISSION_PARTNER
}

model User {
  id                    Int                    @id @default(autoincrement())
  email                 String                 @unique
  password              String?
  role                  Role                   @default(USER)
  entraSubjectId        String?                @unique
  internProfile         InternProfile?
  missionPartnerProfile MissionPartnerProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  sessions      Session[]
  loginAttempts LoginAttempt[]

  filesCreated StoredFile[] @relation("FileCreator")
  filesDeleted StoredFile[] @relation("FileDeleter")
  storedFiles  StoredFile[]
}

enum Condition {
  excellent
  good
  fair
  poor
}

model Stuff {
  id        Int       @id @default(autoincrement())
  name      String
  quantity  Int
  condition Condition @default(good)
  owner     String
}

model Session {
  id           String   @id @default(cuid())
  userId       Int
  sessionToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LoginAttempt {
  id          String   @id @default(cuid())
  userId      Int?
  email       String?
  successful  Boolean
  ipAddress   String?
  attemptedAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, attemptedAt])
  @@index([userId, attemptedAt])
  @@index([ipAddress, attemptedAt])
}

model InternProfile {
  id             Int       @id @default(autoincrement())
  userId         Int       @unique
  firstName      String
  lastName       String
  school         String?
  major          String?
  graduationDate DateTime?
  skills         String[]
  interests      String[]
  status         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MissionPartnerProfile {
  id               Int      @id @default(autoincrement())
  userId           Int      @unique
  organizationName String
  contactName      String?
  contactEmail     String?
  missionArea      String?
  description      String?
  skillsNeeded     String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StoredFile {
  id          Int     @id @default(autoincrement())
  name        String
  url         String  @unique
  pathname    String
  contentType String?
  size        Int // -> BigInt

  //accessibleBy User[] //which user(s) can access the file

  createdById Int? //which user created the file
  createdBy   User?    @relation("FileCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  deletedById Int? //which user deleted the file
  deletedBy   User?     @relation("FileDeleter", fields: [deletedById], references: [id], onDelete: SetNull)
  deletedAt   DateTime?
  user        User?     @relation(fields: [userId], references: [id])
  userId      Int?

  @@index([deletedAt])
  @@index([createdById])
  @@index([deletedById])
}
